OPENAI_API_KEY=sk-...

# Path to the pre-built ILOSTAT dashboard CSV.
# Defaults to <repo_root>/data/dashboard_simple_isco4.csv if unset.
# DASHBOARD_CSV_PATH=/absolute/path/to/dashboard_simple_isco4.csv

# Paths to the pre-computed KPI JSON files (generated by the ETL pipeline).
# Defaults to <repo_root>/data/kpi_summary.json and top_movers.json.
# KPI_SUMMARY_JSON_PATH=/absolute/path/to/kpi_summary.json
# TOP_MOVERS_JSON_PATH=/absolute/path/to/top_movers.json

# Ed25519 signing keys (auto-generated to <repo_root>/keys/ on first server start if absent).
# Override to use pre-existing keys in CI or production.
# ED25519_PRIVATE_KEY_PATH=/absolute/path/to/passport_signing_key.pem
# ED25519_PUBLIC_KEY_PATH=/absolute/path/to/passport_verifying_key.pem

# DID-style identifier embedded in every passport proof block.
# PASSPORT_VERIFICATION_METHOD=did:web:candidateconnect.local#key-1
